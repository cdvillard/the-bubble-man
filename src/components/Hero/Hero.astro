---
import './Hero.css';
---

<header class="hero">
	<div class="hero-copy">
		<p class="hero-kicker">Stylized portrait study</p>
		<h1 id="title">The Bubble Man</h1>
		<p id="subtitle">
			A clean vector portrait focused on the subject alone, with the distracting bubble foreground
			and park background removed.
		</p>
		<div class="hero-actions">
			<a class="hero-link hero-link-primary" href="/bubble-man.svg" download>
				Download SVG
			</a>
			<a class="hero-link" href="/bubble-man.svg" target="_blank" rel="noreferrer">
				Open artwork
			</a>
		</div>
	</div>

	<figure class="hero-portrait" id="portrait-card">
		<img
			src="/bubble-man.svg"
			alt="Stylized portrait of a man in a long dark coat, isolated from the background."
			width="900"
			height="1100"
		/>
	</figure>
</header>

<script>
	import './Hero.js';
</script>
