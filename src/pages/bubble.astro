---
const pageTitle = "Bubble Trail";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<style>
			:global(body) {
				margin: 0;
				overflow: hidden;
				background: #04040a;
			}

			.trail-page {
				position: relative;
				min-height: 100vh;
				overflow: hidden;
				touch-action: none;
				cursor: grab;
				background:#fff;
				transform: translate3d(var(--trail-offset-x, 0px), var(--trail-offset-y, 0px), 0)
					scale(var(--trail-scale, 1));
				transform-origin: center center;
				will-change: transform;
			}

			.trail-page.is-dragging {
				cursor: grabbing;
			}

			.trail-canvas {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				display: block;
			}
		</style>
	</head>
	<body>
		<main class="trail-page" data-trail-root>
			<canvas class="trail-canvas" data-trail-canvas></canvas>
		</main>

		<script>
			import * as THREE from "three";
			import { RoomEnvironment } from "three/addons/environments/RoomEnvironment.js";

			type DetachedBubble = {
				group: THREE.Group;
				mesh: THREE.Mesh;
				material: THREE.MeshPhysicalMaterial;
				headCap: THREE.Mesh;
				tailCap: THREE.Mesh;
				phase: number;
				releasedAt: number;
				popStarted: boolean;
				popElapsed: number;
				popMesh: THREE.InstancedMesh;
				popMaterial: THREE.MeshBasicMaterial;
				popPositions: THREE.Vector3[];
				popVelocities: THREE.Vector3[];
			};

			const root = document.querySelector("[data-trail-root]");
			const canvas = document.querySelector("[data-trail-canvas]");

			if (!(root instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) {
				throw new Error("Bubble trail canvas not found.");
			}

			const scene = new THREE.Scene();
			const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 20);
			camera.position.z = 4;
			const renderer = new THREE.WebGLRenderer({
				canvas,
				antialias: true,
				alpha: true,
				powerPreference: "high-performance",
			});
			renderer.outputColorSpace = THREE.SRGBColorSpace;
			renderer.setClearColor(0x000000, 0);
			renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

			const pmremGenerator = new THREE.PMREMGenerator(renderer);
			const environmentTarget = pmremGenerator.fromScene(new RoomEnvironment(), 0.05);
			scene.environment = environmentTarget.texture;

			const ambient = new THREE.HemisphereLight(0xc9ddff, 0x161c2f, 1.1);
			scene.add(ambient);

			const keyLight = new THREE.DirectionalLight(0xffffff, 1.35);
			keyLight.position.set(2.1, 2.6, 2.3);
			scene.add(keyLight);

			const TRAIL_SEGMENTS = 36;
			const POP_PARTICLE_COUNT = 28;
			const TUBE_RADIAL_SEGMENTS = 20;
			const MAX_BUBBLES = 10;
			const trail = Array.from({ length: TRAIL_SEGMENTS }, () => new THREE.Vector3(0, 0, 0));
			const worldPointer = new THREE.Vector2(0, 0);
			const worldTarget = new THREE.Vector2(0, 0);

			const pointer = new THREE.Vector2(0.5, 0.5);
			const target = new THREE.Vector2(0.5, 0.5);
			let isDragging = false;
			let trailOpacity = 0;
			let pointerVelocity = 0;
			let rafId = 0;
			let elapsed = 0;
			let worldWidth = 2;
			let worldHeight = 2;
			let worldDepthStep = 0.008;
			const detachedBubbles: DetachedBubble[] = [];

			const POP_DELAY = 4;
			const POP_DURATION = 0.9;
			const UNDULATION_AMPLITUDE = 0.012;

			const bubbleMaterial = new THREE.MeshPhysicalMaterial({
				color: 0xffffff,
				transparent: true,
				opacity: 0.72,
				roughness: 0.0,
				metalness: 0.0,
				transmission: 1.0,
				thickness: 0.28,
				ior: 1.03,
				iridescence: 1.0,
				iridescenceIOR: 1.8,
				iridescenceThicknessRange: [180, 680],
				clearcoat: 1.0,
				clearcoatRoughness: 0.0,
				envMapIntensity: 2.75,
				depthWrite: false,
			});

			bubbleMaterial.onBeforeCompile = (shader) => {
				shader.uniforms.uTime = { value: 0 };
				shader.uniforms.uTrailMix = { value: 0 };
				shader.vertexShader = `uniform float uTime;\nuniform float uTrailMix;\n${shader.vertexShader}`;
				shader.vertexShader = shader.vertexShader.replace(
					"#include <begin_vertex>",
					`#include <begin_vertex>
					float microWaveA = sin(position.y * 3.6 + uTime * 0.7 + uTrailMix * 1.1);
					float microWaveB = sin(position.x * 4.2 - uTime * 0.6 + uTrailMix * 0.9);
					float microWave = microWaveA * 0.6 + microWaveB * 0.4;
					transformed += normal * (0.012 * microWave);
				`
				);
				bubbleMaterial.userData.shader = shader;
			};

			let trailGeometry = new THREE.TubeGeometry(
				new THREE.LineCurve3(new THREE.Vector3(0, 0, 0), new THREE.Vector3(0.001, 0, 0)),
				4,
				0.001,
				TUBE_RADIAL_SEGMENTS,
				false
			);
			const trailMesh = new THREE.Mesh(trailGeometry, bubbleMaterial);
			trailMesh.visible = false;
			scene.add(trailMesh);

			const endCapGeometry = new THREE.SphereGeometry(1, TUBE_RADIAL_SEGMENTS, TUBE_RADIAL_SEGMENTS);
			const trailHeadCap = new THREE.Mesh(endCapGeometry, bubbleMaterial);
			const trailTailCap = new THREE.Mesh(endCapGeometry, bubbleMaterial);
			trailHeadCap.visible = false;
			trailTailCap.visible = false;
			scene.add(trailHeadCap);
			scene.add(trailTailCap);

			const popParticleGeometry = new THREE.SphereGeometry(1, 10, 10);
			const popParticleMaterial = new THREE.MeshBasicMaterial({
				color: 0xd6f2ff,
				transparent: true,
				opacity: 0,
				blending: THREE.AdditiveBlending,
				depthWrite: false,
			});
			const popDummy = new THREE.Object3D();

			const clamp01 = (value) => Math.min(Math.max(value, 0), 1);

			const getUndulationOffset = (point, time, trailMix) => {
				const microWaveA = Math.sin(point.y * 3.6 + time * 0.7 + trailMix * 1.1);
				const microWaveB = Math.sin(point.x * 4.2 - time * 0.6 + trailMix * 0.9);
				const microWave = microWaveA * 0.6 + microWaveB * 0.4;
				return UNDULATION_AMPLITUDE * microWave;
			};

			const updateTargetFromEvent = (event) => {
				const rect = root.getBoundingClientRect();
				target.x = clamp01((event.clientX - rect.left) / Math.max(rect.width, 1));
				target.y = clamp01((event.clientY - rect.top) / Math.max(rect.height, 1));
				worldTarget.x = (target.x - 0.5) * worldWidth;
				worldTarget.y = -(target.y - 0.5) * worldHeight;
			};

			const disposeDetachedBubble = (bubble: DetachedBubble) => {
				scene.remove(bubble.group);
				scene.remove(bubble.popMesh);
				bubble.mesh.geometry.dispose();
				bubble.material.dispose();
				bubble.popMaterial.dispose();
			};

			const spawnDetachedBubble = () => {
				if (!trailMesh.visible) {
					return;
				}

				const material = bubbleMaterial.clone();
				material.opacity = bubbleMaterial.opacity;
				const mesh = new THREE.Mesh(trailGeometry.clone(), material);

				const headCap = new THREE.Mesh(endCapGeometry, material);
				headCap.position.copy(trailHeadCap.position);
				headCap.scale.copy(trailHeadCap.scale);

				const tailCap = new THREE.Mesh(endCapGeometry, material);
				tailCap.position.copy(trailTailCap.position);
				tailCap.scale.copy(trailTailCap.scale);

				const group = new THREE.Group();
				group.add(mesh);
				group.add(headCap);
				group.add(tailCap);
				scene.add(group);

				const popMaterial = popParticleMaterial.clone();
				const popMesh = new THREE.InstancedMesh(
					popParticleGeometry,
					popMaterial,
					POP_PARTICLE_COUNT
				);
				popMesh.visible = false;
				popMesh.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
				scene.add(popMesh);

				const popPositions = Array.from(
					{ length: POP_PARTICLE_COUNT },
					() => new THREE.Vector3(0, 0, 0)
				);
				const popVelocities = Array.from(
					{ length: POP_PARTICLE_COUNT },
					() => new THREE.Vector3(0, 0, 0)
				);

				detachedBubbles.push({
					group,
					mesh,
					material,
					headCap,
					tailCap,
					phase: Math.random() * Math.PI * 2,
					releasedAt: elapsed,
					popStarted: false,
					popElapsed: 0,
					popMesh,
					popMaterial,
					popPositions,
					popVelocities,
				});

				if (detachedBubbles.length > MAX_BUBBLES) {
					const oldest = detachedBubbles.shift();
					if (oldest) {
						disposeDetachedBubble(oldest);
					}
				}
			};

			const updateDetachedBubbles = (dt) => {
				for (let i = detachedBubbles.length - 1; i >= 0; i -= 1) {
					const bubble = detachedBubbles[i];
					const age = elapsed - bubble.releasedAt;

					if (!bubble.popStarted) {
						if (age < POP_DELAY) {
							const progress = Math.min(Math.max(age / POP_DELAY, 0), 1);
							const driftWave = Math.sin(elapsed * 0.9 + bubble.phase) * 0.012;
							const liftWave = Math.sin(elapsed * 1.35 + bubble.phase * 1.25) * 0.008;
							const swayWave = Math.cos(elapsed * 0.7 + bubble.phase * 0.9) * 0.006;
							bubble.group.position.y = progress * 0.14 + liftWave;
							bubble.group.position.x = driftWave + swayWave;
							bubble.group.position.z = Math.sin(elapsed * 1.1 + bubble.phase) * 0.004;
							bubble.group.rotation.x = Math.sin(elapsed * 0.8 + bubble.phase) * 0.06;
							bubble.group.rotation.z = Math.cos(elapsed * 0.65 + bubble.phase) * 0.05;
						} else {
							bubble.popStarted = true;
							bubble.popElapsed = 0;
							bubble.group.visible = false;

							const center = new THREE.Vector3();
							bubble.headCap.getWorldPosition(center);
							for (let p = 0; p < POP_PARTICLE_COUNT; p += 1) {
								const angle = Math.random() * Math.PI * 2;
								const spread = 0.23 + Math.random() * 0.32;
								const lift = (Math.random() - 0.5) * 0.18;
								bubble.popPositions[p].copy(center);
								bubble.popVelocities[p].set(
									Math.cos(angle) * spread,
									Math.sin(angle) * spread,
									lift
								);
								const scale = 0.024 + Math.random() * 0.03;
								popDummy.position.copy(bubble.popPositions[p]);
								popDummy.scale.setScalar(scale);
								popDummy.updateMatrix();
								bubble.popMesh.setMatrixAt(p, popDummy.matrix);
							}

							bubble.popMesh.visible = true;
							bubble.popMesh.instanceMatrix.needsUpdate = true;
							bubble.popMaterial.opacity = 0.95;
						}
					}

					if (bubble.popStarted) {
						bubble.popElapsed += dt;
						const life = Math.min(bubble.popElapsed / POP_DURATION, 1);
						const damping = Math.exp(-dt * 2.7);

						for (let p = 0; p < POP_PARTICLE_COUNT; p += 1) {
							const velocity = bubble.popVelocities[p];
							velocity.multiplyScalar(damping);
							velocity.y += dt * 0.035;
							bubble.popPositions[p].addScaledVector(velocity, dt);
							const scale =
								(0.038 - life * 0.02) *
								(0.75 + Math.sin(p * 2.1 + elapsed * 6.2) * 0.12);
							popDummy.position.copy(bubble.popPositions[p]);
							popDummy.scale.setScalar(Math.max(scale, 0.004));
							popDummy.updateMatrix();
							bubble.popMesh.setMatrixAt(p, popDummy.matrix);
						}

						bubble.popMesh.instanceMatrix.needsUpdate = true;
						bubble.popMaterial.opacity = 0.95 * (1 - life);

						if (life >= 1) {
							disposeDetachedBubble(bubble);
							detachedBubbles.splice(i, 1);
						}
					}
				}
			};

			const onPointerDown = (event) => {
				isDragging = true;
				root.classList.add("is-dragging");
				trailOpacity = Math.max(trailOpacity, 0.1);
				pointerVelocity = 0;
				if (event.pointerId !== undefined) {
					root.setPointerCapture(event.pointerId);
				}
				updateTargetFromEvent(event);
				worldPointer.copy(worldTarget);
				for (let i = 0; i < TRAIL_SEGMENTS; i += 1) {
					trail[i].set(worldPointer.x, worldPointer.y, -0.06 - i * worldDepthStep);
				}
			};

			const onPointerMove = (event) => {
				if (!isDragging) {
					return;
				}
				updateTargetFromEvent(event);
			};

			const onPointerUp = (event) => {
				if (event.pointerId !== undefined && root.hasPointerCapture(event.pointerId)) {
					root.releasePointerCapture(event.pointerId);
				}
				spawnDetachedBubble();
				isDragging = false;
				trailOpacity = 0;
				trailMesh.visible = false;
				trailHeadCap.visible = false;
				trailTailCap.visible = false;
				root.classList.remove("is-dragging");
			};

			const updateContinuousBody = (opacity) => {
				if (opacity < 0.01) {
					trailMesh.visible = false;
					trailHeadCap.visible = false;
					trailTailCap.visible = false;
					return;
				}

				const points = [];
				for (let i = 0; i < TRAIL_SEGMENTS; i += 1) {
					points.push(new THREE.Vector3(trail[i].x, trail[i].y, -0.06 - i * 0.007));
				}

				if (points.length >= 2 && points[0].distanceTo(points[points.length - 1]) < 0.001) {
					points[points.length - 1].x += 0.001;
				}

				const curve = new THREE.CatmullRomCurve3(points, false, "centripetal", 0.45);
				const tubularSegments = TRAIL_SEGMENTS * 5;
				const radius = Math.max((0.03 + pointerVelocity * 0.022) * opacity, 0.004) * 2;

				const nextGeometry = new THREE.TubeGeometry(
					curve,
					tubularSegments,
					radius,
					TUBE_RADIAL_SEGMENTS,
					false
				);
				trailMesh.geometry.dispose();
				trailMesh.geometry = nextGeometry;
				trailGeometry = nextGeometry;
				trailMesh.visible = true;
				trailHeadCap.visible = true;
				trailTailCap.visible = true;
				trailHeadCap.position.copy(points[0]);
				trailTailCap.position.copy(points[points.length - 1]);

				const trailMix = pointerVelocity * trailOpacity;
				const headScale = Math.max(
					radius + getUndulationOffset(points[0], elapsed, trailMix),
					0.002
				);
				const tailScale = Math.max(
					radius + getUndulationOffset(points[points.length - 1], elapsed, trailMix),
					0.002
				);
				trailHeadCap.scale.setScalar(headScale);
				trailTailCap.scale.setScalar(tailScale);
				bubbleMaterial.opacity = 0.72 * opacity;
			};

			const resize = () => {
				const width = Math.max(1, root.clientWidth);
				const height = Math.max(1, root.clientHeight);
				const aspect = width / height;
				renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
				renderer.setSize(width, height, false);
				camera.left = -aspect;
				camera.right = aspect;
				camera.top = 1;
				camera.bottom = -1;
				camera.updateProjectionMatrix();
				worldWidth = camera.right - camera.left;
				worldHeight = camera.top - camera.bottom;
				worldDepthStep = worldHeight / (TRAIL_SEGMENTS * 22);
			};

			const updateTrail = (dt) => {
				elapsed += dt;
				const follow = 1 - Math.exp(-dt * 15);
				const fade = 1 - Math.exp(-dt * 14);
				const previousX = pointer.x;
				const previousY = pointer.y;
				pointer.x += (target.x - pointer.x) * follow;
				pointer.y += (target.y - pointer.y) * follow;

				const dx = pointer.x - previousX;
				const dy = pointer.y - previousY;
				const speed = Math.min(Math.hypot(dx, dy) * 420, 1);
				const velocityTarget = isDragging ? speed : 0;
				pointerVelocity += (velocityTarget - pointerVelocity) * (1 - Math.exp(-dt * 10));
				const opacityTarget = isDragging ? 1 : 0;
				trailOpacity += (opacityTarget - trailOpacity) * fade;

				if (isDragging) {
					worldPointer.x += (worldTarget.x - worldPointer.x) * (1 - Math.exp(-dt * 18));
					worldPointer.y += (worldTarget.y - worldPointer.y) * (1 - Math.exp(-dt * 18));

					trail[0].x = worldPointer.x;
					trail[0].y = worldPointer.y;

					for (let i = 1; i < TRAIL_SEGMENTS; i += 1) {
						const lead = trail[i - 1];
						const segment = trail[i];
						const lag = 1 - Math.exp(-dt * (16 - i * 0.22));
						segment.x += (lead.x - segment.x) * lag;
						segment.y += (lead.y - segment.y) * lag;
					}
				}

				updateContinuousBody(trailOpacity);
				updateDetachedBubbles(dt);

				const shader = bubbleMaterial.userData.shader;
				if (shader?.uniforms?.uTime && shader?.uniforms?.uTrailMix) {
					shader.uniforms.uTime.value = elapsed;
					shader.uniforms.uTrailMix.value = pointerVelocity * trailOpacity;
				}
			};

			let last = performance.now();
			const tick = (now) => {
				const dt = Math.min((now - last) / 1000, 1 / 24);
				last = now;
				updateTrail(dt);
				const driftX = Math.sin(elapsed * 0.55) * 0.8;
				const driftY = Math.cos(elapsed * 0.45 + 0.35) * 0.6;
				const driftScale = 1 + Math.sin(elapsed * 0.8 + 0.2) * 0.003;
				root.style.setProperty("--trail-offset-x", `${driftX}px`);
				root.style.setProperty("--trail-offset-y", `${driftY}px`);
				root.style.setProperty("--trail-scale", driftScale.toFixed(4));
				renderer.render(scene, camera);
				rafId = requestAnimationFrame(tick);
			};

			const cleanup = () => {
				cancelAnimationFrame(rafId);
				root.removeEventListener("pointerdown", onPointerDown);
				root.removeEventListener("pointermove", onPointerMove);
				root.removeEventListener("pointerup", onPointerUp);
				root.removeEventListener("pointercancel", onPointerUp);
				root.removeEventListener("pointerleave", onPointerUp);
				window.removeEventListener("resize", resize);
				window.removeEventListener("pagehide", cleanup);
				for (const bubble of detachedBubbles) {
					disposeDetachedBubble(bubble);
				}
				detachedBubbles.length = 0;
				trailGeometry.dispose();
				endCapGeometry.dispose();
				popParticleGeometry.dispose();
				popParticleMaterial.dispose();
				bubbleMaterial.dispose();
				environmentTarget.texture.dispose();
				pmremGenerator.dispose();
				renderer.dispose();
			};

			root.addEventListener("pointerdown", onPointerDown);
			root.addEventListener("pointermove", onPointerMove);
			root.addEventListener("pointerup", onPointerUp);
			root.addEventListener("pointercancel", onPointerUp);
			root.addEventListener("pointerleave", onPointerUp);
			window.addEventListener("resize", resize, { passive: true });
			window.addEventListener("pagehide", cleanup, { once: true });

			resize();
			rafId = requestAnimationFrame(tick);
		</script>
	</body>
</html>
